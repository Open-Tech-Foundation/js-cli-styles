{
  "name": "@opentf/cli-styles",
  "version": "0.15.0",
  "description": "Style your CLI text using ANSI escape sequences.",
  "keywords": [
    "ansi",
    "cli",
    "style",
    "string",
    "text",
    "color",
    "format",
    "console",
    "log",
    "terminal"
  ],
  "author": {
    "name": "Thanga Ganapathy",
    "email": "ganapathy888@gmail.com",
    "url": "https://thanga-ganapathy.github.io"
  },
  "license": "MIT",
  "homepage": "https://github.com/open-tech-foundation/js-cli-styles",
  "repository": "git@github.com:Open-Tech-Foundation/js-cli-styles.git",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "jest",
    "lint": "eslint src/** --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "bench": "node --expose-gc bench/comparison.js",
    "type-check": "tsc",
    "ci": "turbo run build test lint type-check",
    "prepare": "husky install",
    "publish-packages": "pnpm run build && pnpm run test && changeset version && changeset publish"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm run format",
      "pnpm run lint"
    ],
    "*.json": [
      "pnpm run format"
    ]
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@opentf/eslint-config-base": "^0.2.0",
    "@swc/core": "^1.4.8",
    "@swc/jest": "^0.2.24",
    "ansi-colors": "^4.1.3",
    "ansis": "^3.3.2",
    "chalk": "^5.3.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.12.2",
    "eslint": "^8.57.0",
    "highlight.js": "^11.9.0",
    "html-entities": "^2.5.2",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "kleur": "^4.1.5",
    "lint-staged": "^15.2.2",
    "picocolors": "^1.0.1",
    "tinybench": "^2.8.0",
    "tsup": "^8.0.2",
    "turbo": "^1.13.0",
    "typescript": "^5.4.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@opentf/std": "^0.3.0"
  }
}
