{
  "name": "@opentf/cli-styles",
  "version": "0.15.0",
  "description": "Style your CLI text using ANSI escape sequences.",
  "keywords": [
    "ansi",
    "cli",
    "style",
    "string",
    "text",
    "color",
    "format",
    "console",
    "log",
    "terminal"
  ],
  "author": {
    "name": "Thanga Ganapathy",
    "email": "ganapathy888@gmail.com",
    "url": "https://thanga-ganapathy.github.io"
  },
  "license": "MIT",
  "homepage": "https://github.com/open-tech-foundation/js-cli-styles",
  "repository": "git@github.com:Open-Tech-Foundation/js-cli-styles.git",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "jest",
    "lint": "eslint src/** --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "bench": "node --expose-gc bench/comparison.js",
    "type-check": "tsc",
    "ci": "turbo run build test lint type-check",
    "publish-packages": "pnpm run build && pnpm run test && changeset version && changeset publish"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm run format",
      "pnpm run lint"
    ],
    "*.json": [
      "pnpm run format"
    ]
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.34.0",
    "@swc/core": "^1.13.4",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.13",
    "ansi-colors": "^4.1.3",
    "ansis": "^4.1.0",
    "chalk": "^5.6.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-turbo": "^2.5.6",
    "globals": "^16.3.0",
    "highlight.js": "^11.11.1",
    "html-entities": "^2.6.0",
    "jest": "^29.7.0",
    "kleur": "^4.1.5",
    "picocolors": "^1.1.1",
    "prettier": "^3.6.2",
    "tinybench": "^2.9.0",
    "tsup": "^8.5.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@opentf/std": "^0.13.0"
  }
}
